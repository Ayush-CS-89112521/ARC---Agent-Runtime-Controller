# The isolated database setup writes DATABASE_URL to .env.
# DATABASE_URL=postgresql://arc_app:YOUR_TEST_PASSWORD@127.0.0.1:15432/arc_test

# Use a trusted local model directory and a user-owned adapter config.
# ARC_LOCAL_EMBEDDING_PATH=./models/minilm
# ARC_RUNTIME_CONFIG=./arc-runtime.local.json

# Optional paid documentation extraction. Leave disabled for local checks.
ENABLE_WEB_SCRAPING=false
# ANTHROPIC_API_KEY=
