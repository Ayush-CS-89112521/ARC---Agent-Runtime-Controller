{
  "name": "agent-runtime-controller",
  "version": "0.1.0",
  "description": "ARC (Agent Runtime Controller) - Multi-step workflow engine & local-first deterministic execution runtime",
  "type": "module",
  "main": "dist/cli.js",
  "bin": {
    "arc": "dist/cli.js"
  },
  "scripts": {
    "dev": "bun run src/cli.ts",
    "build": "bun run scripts/build.ts",
    "type-check": "tsc --noEmit",
    "lint": "eslint src",
    "test": "bun test",
    "verify": "npm run type-check && npm run lint && npm run build && npm test -- --timeout 15000",
    "parse-mcp": "bun run scripts/parse-mcp-servers.ts",
    "parse-apis": "bun run scripts/parse-public-apis.ts",
    "sync-catalogs": "bun run scripts/sync-external-resources.ts",
    "arc": "bun run src/cli.ts",
    "db:setup": "node scripts/setup-postgres-test.mjs",
    "db:start": "docker compose --env-file .env.postgres-test -f compose.postgres-test.yaml up -d --wait",
    "db:stop": "docker compose --env-file .env.postgres-test -f compose.postgres-test.yaml stop",
    "db:verify": "bun run scripts/verify-postgres-test.ts",
    "temporal:start": "node scripts/setup-temporal-test.mjs",
    "temporal:stop": "docker compose -f compose.temporal-test.yaml stop",
    "temporal:worker": "node --env-file=.env.temporal-test dist/src/temporal/worker.js",
    "temporal:verify": "npm run build && node scripts/verify-temporal-runtime.mjs",
    "rag:verify": "bun run scripts/verify-functional-rag.ts",
    "embedding:verify": "bun run scripts/verify-local-embedding.ts",
    "embedding:pretrained": "bun run scripts/verify-pretrained-embedding.ts"
  },
  "keywords": [
    "github",
    "copilot",
    "cli",
    "workflow",
    "yaml",
    "automation"
  ],
  "author": "Copilot Hackathon Team",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.73.0",
    "@huggingface/transformers": "4.3.2",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@temporalio/activity": "^1.25.0",
    "@temporalio/client": "^1.25.0",
    "@temporalio/common": "^1.25.0",
    "@temporalio/proto": "^1.25.0",
    "@temporalio/worker": "^1.25.0",
    "@temporalio/workflow": "^1.25.0",
    "ajv": "^8.20.0",
    "chalk": "^5.3.0",
    "inquirer": "^8.2.5",
    "ora": "^7.0.1",
    "pg": "^8.18.0",
    "yaml": "^2.3.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/inquirer": "^9.0.9",
    "@types/node": "^25.2.2",
    "@types/pg": "^8.16.0",
    "bun": "^1.4.4",
    "eslint": "^10.14.0",
    "openai": "^6.18.0",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.72.1"
  },
  "overrides": {
    "eslint": {
      "minimatch": "11.0.5"
    },
    "@eslint/config-array": {
      "minimatch": "11.0.5"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.5"
    }
  }
}
